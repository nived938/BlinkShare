# BlinkShare Environment Variables (100% Free Plan)
APP_NAME=BlinkShare
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# Server-side secrets (Set in .dev.vars for local Wrangler dev)
RATE_LIMIT_SECRET=your-32-char-random-rate-limit-secret
SESSION_SECRET=your-32-char-random-session-secret

# Configurable free-tier limits
MAX_IMAGE_BYTES=5242880
MAX_TEXT_BYTES=102400
