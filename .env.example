# BlinkShare Frontend & Shared Environment Variables
APP_NAME=BlinkShare
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# Server-side secrets (Set in .dev.vars for local Wrangler dev)
RATE_LIMIT_SECRET=your-32-char-random-rate-limit-secret
SESSION_SECRET=your-32-char-random-session-secret

# Image Storage Configuration ('local' for simulation without billing | 'r2' for production R2 | 'disabled')
IMAGE_STORAGE_MODE=local

# Billing Provider configuration ('none' | 'stripe' | 'razorpay')
BILLING_PROVIDER=none

# Razorpay credentials (if BILLING_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe credentials (if BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email delivery
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@blinkshare.io
RESEND_API_KEY=
