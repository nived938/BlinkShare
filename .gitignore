# ==============================================================================
# BlinkShare Monorepo .gitignore
# ==============================================================================

# Dependencies & Package Managers
node_modules/
*/node_modules/
.pnpm-store/
.npm/
.yarn/

# Production Build & Compiler Outputs
dist/
*/dist/
build/
*/build/
.output/
out/
*.tsbuildinfo
.tsbuildinfo

# Bundler & Framework Caches
.vite/
*/.vite/
.turbo/
.parcel-cache/
.cache/

# Cloudflare Workers, Wrangler & Miniflare local runtime
.wrangler/
*/.wrangler/
.mf/
*/.mf/

# Local Environment Variables, Secrets & Credentials
.dev.vars
*/.dev.vars
.dev.vars.*
.env
*/.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt

# Keep example & template environment files tracked
!.env.example
!.dev.vars.example
!*.example

# Local SQLite databases & temporary state
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
scratch/
temp/
tmp/
*.tmp

# Test Coverage & Automation Reports
coverage/
*/coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Logs & Debugging Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor, IDE & Tool Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
